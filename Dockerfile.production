# Hanzo Commerce - Production Build
# Multi-stage build for minimal production image

# ── Stage 1: THE Commerce admin, built from source ────────────────────────────
# ui/dist is //go:embed'd into the binary and is BUILD OUTPUT, not tracked
# content — it used to be hand-synced and committed, which is exactly how it went
# stale (the binary shipped a retired Vite bundle while app/admin had moved on).
# Building it here makes the embedded admin a function of this commit, always.
#
# @hanzo/ui is a WORKSPACE SOURCE dep (`link:../../../ui/pkg/ui`). A single-repo
# build context cannot see the sibling checkout, so resolve it from the registry:
# pass the published range as PNPM_HANZO_UI and the manifest is rewritten before
# install. Local dev keeps the source link.
FROM node:20-slim AS admin-build
RUN npm install -g pnpm@9.15.9
WORKDIR /build
# The FE pnpm workspace is the only input the admin build needs.
COPY app/ ./app/
WORKDIR /build/app
ARG PNPM_HANZO_UI=^8.0.12
RUN sed -i "s#\"@hanzo/ui\": \"link:[^\"]*\"#\"@hanzo/ui\": \"${PNPM_HANZO_UI}\"#" admin/package.json \
 && pnpm install --no-frozen-lockfile

# Prod defaults baked into the client bundle (Next inlines NEXT_PUBLIC_*).
# commerce.hanzo.ai is same-origin for the API (bare /v1/*) because the admin is
# served BY this binary; hanzo.id is the OIDC issuer; client_id hanzo-commerce is
# the PKCE client; the AI dock calls the api.hanzo.ai chat-completions gateway.
ENV NEXT_PUBLIC_COMMERCE_API_URL=https://commerce.hanzo.ai \
    NEXT_PUBLIC_IAM_SERVER_URL=https://hanzo.id \
    NEXT_PUBLIC_IAM_CLIENT_ID=hanzo-commerce \
    NEXT_PUBLIC_HANZO_AI_URL=https://api.hanzo.ai/v1/chat/completions \
    NEXT_PUBLIC_HANZO_AI_MODEL=best

# typecheck is a real gate: the admin renders @hanzo/ui/product from source, so a
# drift in the shared component set fails HERE, not in a browser.
RUN node_modules/.bin/turbo run typecheck build --filter=@hanzo/commerce-dashboard

# ── Stage 2: the Go binary, with that export baked in ─────────────────────────
FROM golang:1.26.4-alpine AS builder

# Install build dependencies (curl for scripts/fetch-plans.sh; bash + rsync for
# scripts/sync-admin-ui.sh, which is the one producer of the embedded admin)
RUN apk add --no-cache git ca-certificates tzdata gcc musl-dev curl bash rsync

WORKDIR /build

# Private hanzoai/* Go modules resolve via authenticated git, NOT the public
# proxy (which cannot serve private repos). GOPRIVATE skips proxy.golang.org +
# sumdb for them; the git credential is the BuildKit `gh_token` secret — the ONE
# secret both build paths supply (hanzoai/ci reusable + platform BuildKit Job).
ENV GOPRIVATE=github.com/hanzoai/*

# Copy ALL source first
COPY . .

# Remove local replace directives and use pseudo-version for production build.
# --mount=type=secret,id=gh_token authenticates `go mod download` to private
# hanzoai/* repos. The credential is written to an in-layer GIT_CONFIG_GLOBAL
# that is deleted within the SAME RUN, so no token is ever baked into any layer.
RUN --mount=type=secret,id=gh_token \
    export GIT_CONFIG_GLOBAL=/tmp/gitconfig && \
    if [ -s /run/secrets/gh_token ]; then \
      git config --global url."https://x-access-token:$(cat /run/secrets/gh_token)@github.com/".insteadOf "https://github.com/"; \
    fi && \
    go mod download github.com/hanzoai/... $(go list -m -f '{{if not .Indirect}}{{.Path}}{{end}}' all 2>/dev/null | grep -v '^$' | head -200) 2>/dev/null || true && \
    rm -f /tmp/gitconfig

# Hydrate @hanzo/plans (public npm, no auth) — api/billing/plans.go go:embed's
# plans/{dns,subscription}.json at compile time, and that dir is gitignored, so
# the build MUST fetch it before `go build` (same contract as test.yml CI).
RUN sh scripts/fetch-plans.sh

# Bake the admin export into ui/dist for //go:embed. Same contract as the plans
# hydrate above: the directory is gitignored build output, so the ONE producer
# (scripts/sync-admin-ui.sh, fed by app/admin/out) must run before `go build`.
COPY --from=admin-build /build/app/admin/out ./app/admin/out
RUN bash scripts/sync-admin-ui.sh

# Build the binary - build the WHOLE cmd/commerce PACKAGE (not just main.go):
# boot is split across sibling files (legacy.go's bootLegacy + cloud_stub.go's
# bootCloud under //go:build !cloud), so a single-file build leaves them
# undefined. Default tags = the legacy Gin boot the deployment runs
# (COMMERCE_MODE unset); `-tags cloud` is a separate, opt-in variant.
RUN CGO_ENABLED=0 go build \
    -ldflags="-s -w" \
    -o /build/commerce \
    ./cmd/commerce

# Production stage
FROM alpine:3.19

# Install runtime dependencies
RUN apk add --no-cache ca-certificates tzdata curl wget

# Create non-root user
RUN addgroup -S hanzo && adduser -S hanzo -G hanzo

WORKDIR /app

# Copy binary from builder
COPY --from=builder /build/commerce /app/commerce

# Copy templates and static assets. Runtime reads only /app/templates/* (see
# util/template: cwd+"/templates/..."), which includes templates/analytics — the
# stale COPY of a now-removed top-level analytics/templates dir was dropped.
COPY --from=builder /build/templates /app/templates
COPY --from=builder /build/api/templates /app/api/templates

# Create data directories
RUN mkdir -p /app/data /app/logs && \
    chown -R hanzo:hanzo /app

USER hanzo

# Expose default port
EXPOSE 8000

# Environment variables
ENV COMMERCE_DIR=/app/data
ENV COMMERCE_DEV=false
ENV COMMERCE_PORT=8000

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=10s --retries=3 \
    CMD wget -q --spider http://localhost:8000/healthz || exit 1

# Default command
ENTRYPOINT ["/app/commerce"]
CMD ["serve", "0.0.0.0:8000"]
