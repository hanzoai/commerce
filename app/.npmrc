# Hoist type packages to the workspace root so every package's `tsc`/dts step can
# resolve them via the normal node_modules walk-up (pnpm isolates by default, which
# otherwise hides @types/react from icons/ui/etc. during declaration emit).
public-hoist-pattern[]=@types/*

# Never ask. When pnpm decides the modules directories must be purged and
# reinstalled it asks "Proceed? (Y/n)" — and in a Docker build or a CI step
# there is no TTY, so the prompt reads EOF and `pnpm install` EXITS ZERO
# HAVING INSTALLED NOTHING. The next command then fails as `next: not found`,
# which reads like a broken dependency and is actually a question nobody was
# there to answer. An install that does nothing must not report success.
confirm-modules-purge=false
