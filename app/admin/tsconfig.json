{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "preserve",
    "strict": true,
    "noEmit": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "incremental": true,
    "paths": {
      "@/*": [
        "./src/*"
      ],
      // ONE React type identity: @hanzo/ui ships raw TS and carries its own
      // @types/react, which TS would otherwise treat as a distinct React.
      //
      // Gui itself is deliberately NOT pinned here. Next feeds tsconfig `paths`
      // to webpack as a resolve plugin that runs BEFORE `resolve.alias`, so a
      // "@hanzogui/*" -> "./node_modules/@hanzogui/*" entry beats every alias and
      // resolves subpaths as DIRECTORIES — past the package `exports` map and
      // onto the legacy Metro stubs, which breaks the static export at prerender.
      // Type identity is already guaranteed by the single pinned version set in
      // package.json; runtime identity is next.config.ts's SINGLETONS aliases.
      "react": [
        "./node_modules/@types/react"
      ],
      "react/*": [
        "./node_modules/@types/react/*"
      ],
      "react-dom": [
        "./node_modules/@types/react-dom"
      ]
    },
    "plugins": [
      {
        "name": "next"
      }
    ],
    "allowJs": true
  },
  "include": [
    "next-env.d.ts",
    "gui.config.ts",
    "gui.d.ts",
    "src",
    ".next/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    ".next",
    "out"
  ]
}
