{
  "name": "@hanzo/commerce-icons",
  "version": "0.1.0",
  "private": true,
  "description": "Hanzo Commerce React icon library",
  "license": "MIT OR Apache-2.0",
  "main": "dist/cjs/commerce-icons.js",
  "main:umd": "dist/umd/commerce-icons.js",
  "module": "dist/esm/index.js",
  "unpkg": "dist/umd/commerce-icons.min.js",
  "typings": "dist/index.d.ts",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "pnpm build:bundles && pnpm build:types",
    "build:bundles": "rollup -c ./rollup.config.mjs",
    "build:types": "tsc --emitDeclarationOnly",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@atomico/rollup-plugin-sizes": "catalog:",
    "@rollup/plugin-node-resolve": "catalog:",
    "@rollup/plugin-replace": "catalog:",
    "esbuild": "catalog:",
    "react": "catalog:",
    "rollup": "catalog:",
    "rollup-plugin-esbuild": "catalog:",
    "rollup-plugin-visualizer": "catalog:",
    "typescript": "catalog:"
  },
  "peerDependencies": {
    "react": ">=19.2.8"
  }
}
