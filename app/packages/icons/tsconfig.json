{
  "compilerOptions": {
    "forceConsistentCasingInFileNames": true,
    "composite": false,
    "declaration": true,
    "declarationMap": true,
    "inlineSources": false,
    "isolatedModules": true,
    "moduleResolution": "bundler",
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "preserveWatchOutput": true,
    "skipLibCheck": true,
    "strict": true,
    "checkJs": false,
    "jsx": "react",
    "lib": ["ES2015", "DOM"],
    "module": "ESNext",
    "target": "es6",
    "resolveJsonModule": true,
    "outDir": "dist",
    "esModuleInterop": true,
    "declarationDir": "dist",
    // Stated, not inferred: TypeScript 7 no longer guesses the common source
    // directory when it emits (TS5011), and `dist/` must mirror `src/` — the
    // package's `typings` names dist/index.d.ts, which is src/index.ts.
    "rootDir": "src",
    "paths": {
      "@hanzo/commerce-icons": [
        "./src/src/index.ts"
      ]
    }
  },
  "include": ["src"],
  "exclude": ["dist", "build", "node_modules", "./src/**/*.spec.tsx"]
}
