FROM node:20-alpine AS base
RUN corepack enable && corepack prepare pnpm@10.8.0 --activate
WORKDIR /app

FROM base AS deps
COPY app/pnpm-workspace.yaml app/package.json app/pnpm-lock.yaml* ./
# site's workspace deps (@hanzo/commerce-docs-ui, -docs-utils, -icons,
# -client) pull transitive workspace deps (docs-ui -> commerce-ui, ...).
# pnpm needs EVERY workspace manifest present to resolve the graph, else
# ERR_PNPM_WORKSPACE_PKG_NOT_FOUND. Copy the whole packages/ tree so the
# closure is always complete regardless of how the graph evolves.
COPY app/packages packages
COPY app/site/package.json site/package.json
# --no-frozen-lockfile absorbs benign lockfile drift (caret-range tightening
# in site/package.json) without a full workspace lockfile regen.
RUN pnpm install --no-frozen-lockfile

FROM base AS builder
# The deps stage already holds the full packages/ source + the installed
# node_modules (root hoist + per-package). Carry the whole resolved
# workspace over, then add the bits deps didn't need: site source + root
# config files.
COPY --from=deps /app /app
COPY app/site site
COPY app/tsconfig.json tsconfig.json
COPY app/turbo.json turbo.json
RUN pnpm --filter=@hanzo/commerce-client build 2>/dev/null || true
RUN cd site && npx next build

# Serve the static export via hanzoai/static (the canonical Hanzo static
# plugin) — NOT nginx. --spa rewrites unknown paths to index.html (Next.js
# export client routing); _next/* assets are served as-is with long cache.
# Listens on :3000 (hanzoai/static default); the commerce-site Service maps
# servicePort 80 -> targetPort 3000.
FROM ghcr.io/hanzoai/static:0.4.1
COPY --from=builder /app/site/out /srv
EXPOSE 3000
ENTRYPOINT ["/static", "--root=/srv", "--spa", "--port=3000"]
