# syntax=docker/dockerfile:1
# commerce-site — the docs/marketing site (app/site) as production serves it: a
# static export behind the canonical hanzoai/static plugin on :3000. Never nginx.
#
# This used to re-serve the content of the old nginx image because app/site did
# not build: it reached for a deleted docs fork, a Tailwind preset that went with
# it, and workspace packages that were never produced. It builds from source now
# — the site renders the one @hanzo/gui component kit on the shared
# @hanzo/ui/gui-config scale — so the image is built from the repo, like the
# admin's, and the pinned-content stage is gone.
#
# ONE producer, ONE URL contract: the export is produced by the same
# `turbo run typecheck build --filter=@hanzo/commerce-site` the CI gate runs, so
# a type error fails the build here too rather than shipping an unstyled page.

# ── Stage 1: build the export from source ─────────────────────────────────────
FROM node:20-slim AS site-build
RUN npm install -g pnpm@9.15.9
WORKDIR /build
COPY app/ ./app/
WORKDIR /build/app
RUN pnpm install --frozen-lockfile

# Next inlines NEXT_PUBLIC_* into the client bundle, so the public origin is a
# build input. SKIP_ENV_VALIDATION is not needed here — that gate belongs to the
# storefront, whose publishable key is resolved per tenant at request time.
ENV NEXT_PUBLIC_BASE_URL=https://commerce.hanzo.ai

RUN node_modules/.bin/turbo run typecheck build --filter=@hanzo/commerce-site

# ── Stage 2: arrange (hanzoai/static has no shell to move files with) ─────────
FROM busybox:1.36 AS arrange
COPY --from=site-build /build/app/site/out /srv

# ── Stage 3: the canonical Hanzo static plugin ────────────────────────────────
# No --spa: `output: "export"` writes an index.html per route, so a real route
# resolves by directory index and a miss stays a 404 instead of answering 200
# with the homepage — which is how a broken bundle hides.
FROM ghcr.io/hanzoai/static:v0.5.2
COPY --from=arrange /srv /srv
EXPOSE 3000
ENTRYPOINT ["/static", "--root=/srv", "--port=3000", "--404=404.html"]
