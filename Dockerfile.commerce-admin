# commerce-admin — THE Commerce admin (app/admin, @hanzo/commerce-dashboard,
# Next.js `output: export`) built FROM SOURCE and served via hanzoai/static
# (NOT nginx, NOT a node server).
#
# v0.3.0: the admin renders `@hanzo/ui/product` — the SAME component set the cloud
# console renders (DataTable, PageHeader, CommerceResource, BackendState, …) — on
# @hanzo/gui. Every merchant list is one row in `src/lib/resources.ts`, so the 19
# resource routes are generated from one catalog rather than 26 hand-written trees.
# `turbo run typecheck build` is a real gate: there is no ignoreBuildErrors.
#
# @hanzo/ui is a WORKSPACE SOURCE dep (`link:../../../ui/pkg/ui`). A single-repo
# build context cannot see the sibling checkout, so the image build resolves it
# from the registry: pass the published range as PNPM_HANZO_UI (default ^8.0.12)
# and the manifest is rewritten before install. Local dev keeps the source link.
#
# NEXT_PUBLIC_* are baked at build time (Next inlines them). No assetPrefix —
# chunks are root-relative (/_next/*), so the static tree serves at ROOT.

# ── Stage 1: build the admin export from source ───────────────────────────────
FROM node:20-slim AS builder
RUN npm install -g pnpm@9.15.9
WORKDIR /build
# The FE pnpm workspace is the only input the admin build needs.
COPY app/ ./app/
WORKDIR /build/app
# Swap the local source link for the published package (see the header note).
ARG PNPM_HANZO_UI=^8.0.12
RUN sed -i "s#\"@hanzo/ui\": \"link:[^\"]*\"#\"@hanzo/ui\": \"${PNPM_HANZO_UI}\"#" admin/package.json \
 && pnpm install --no-frozen-lockfile

# Prod defaults baked into the client bundle. commerce.hanzo.ai is same-origin for
# the API (bare /v1/*); hanzo.id is the OIDC issuer; client_id hanzo-commerce is the
# working PKCE client; the AI dock calls the api.hanzo.ai chat-completions gateway.
ENV NEXT_PUBLIC_COMMERCE_API_URL=https://commerce.hanzo.ai \
    NEXT_PUBLIC_IAM_SERVER_URL=https://hanzo.id \
    NEXT_PUBLIC_IAM_CLIENT_ID=hanzo-commerce \
    NEXT_PUBLIC_HANZO_AI_URL=https://api.hanzo.ai/v1/chat/completions \
    NEXT_PUBLIC_HANZO_AI_MODEL=best

RUN node_modules/.bin/turbo run typecheck build --filter=@hanzo/commerce-dashboard

# ── Stage 2: arrange the served tree (hanzoai/static has no shell) ────────────
FROM busybox:1.36 AS arrange
COPY --from=builder /build/app/admin/out /srv

# ── Stage 3: serve via the canonical Hanzo static plugin on :3000, SPA fallback ─
FROM ghcr.io/hanzoai/static:v0.5.1
COPY --from=arrange /srv /srv
EXPOSE 3000
ENTRYPOINT ["/static", "--root=/srv", "--spa", "--port=3000"]
