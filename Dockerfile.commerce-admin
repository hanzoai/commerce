# commerce-admin — the Medusa-lineage admin SPA (app/admin, @hanzo/commerce-dashboard,
# Next.js `output: 'export'`) built FROM SOURCE and served via hanzoai/static
# (NOT nginx, NOT a node server).
#
# v0.2.5: store onboarding, IAM account and org shell, theme control, merchant
# actions, integrations, and per-store subscription access. `pnpm build`
# is green end-to-end — @hanzo/commerce-ui now builds via tsup (esbuild resolves the
# `@/` aliases; cjs+esm+dts), and the ui-preset/admin-shared/types/sdk build-tooling
# gaps were fixed (see app/packages/*). The phantom `@hanzo/commerce-client` import
# is gone (replaced by @/lib/commerce-client). NEXT_PUBLIC_* are baked at build time
# (Next inlines them). No assetPrefix — chunks are root-relative (/_next/*), so the
# static tree serves at ROOT directly (no /admin/_next duplication needed).

# ── Stage 1: build the admin export from source ───────────────────────────────
FROM node:20-slim AS builder
RUN npm install -g pnpm@9.15.9
WORKDIR /build
# The FE pnpm workspace is the only input the admin build needs.
COPY app/ ./app/
WORKDIR /build/app
RUN pnpm install --frozen-lockfile

# Prod defaults baked into the client bundle. commerce.hanzo.ai is same-origin for
# the API (bare /v1/*); hanzo.id is the OIDC issuer; client_id hanzo-commerce is the
# working PKCE client; the AI dock calls the api.hanzo.ai chat-completions gateway.
ENV NEXT_PUBLIC_COMMERCE_API_URL=https://commerce.hanzo.ai \
    NEXT_PUBLIC_IAM_SERVER_URL=https://hanzo.id \
    NEXT_PUBLIC_IAM_CLIENT_ID=hanzo-commerce \
    NEXT_PUBLIC_HANZO_AI_URL=https://api.hanzo.ai/v1/chat/completions \
    NEXT_PUBLIC_HANZO_AI_MODEL=best

RUN node_modules/.bin/turbo run build --filter=@hanzo/commerce-dashboard

# ── Stage 2: arrange the served tree (hanzoai/static has no shell) ────────────
FROM busybox:1.36 AS arrange
COPY --from=builder /build/app/admin/out /srv

# ── Stage 3: serve via the canonical Hanzo static plugin on :3000, SPA fallback ─
FROM ghcr.io/hanzoai/static:0.4.1
COPY --from=arrange /srv /srv
EXPOSE 3000
ENTRYPOINT ["/static", "--root=/srv", "--spa", "--port=3000"]
